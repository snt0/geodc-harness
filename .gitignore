bin/
obj/
/TestResults/
/artifacts/

# UI driver state and its regenerable sample projects (docs/ui-driver.md)
/.ui-driver/
/dev/sample-projects/

# Session-local Claude Code permission decisions and agent worktrees
.claude/settings.local.json
.claude/worktrees/

.agents/*
!.agents/skills/
!.agents/skills/**
/.codex/*
!/.codex/rules/
!/.codex/rules/*.rules

.vs/
.vscode/
.idea/
