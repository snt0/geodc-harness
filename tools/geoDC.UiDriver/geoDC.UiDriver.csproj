<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- UseWPF only for BitmapSource/PngBitmapEncoder (framework, not a package) so
         FlaUI.UIA3 stays the single NuGet dependency. This remains a console app. -->
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>geoDC.UiDriver</RootNamespace>
    <AssemblyName>geodc-ui</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Public members carry XML documentation, and a missing or broken doc comment fails the build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1570;CS1572;CS1573;CS1574;CS1584;CS1591;CS1658;CS1734</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\geoDC.UiDriver.Core\geoDC.UiDriver.Core.csproj" />
  </ItemGroup>

</Project>
